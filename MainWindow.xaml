<Window x:Class="LaravelLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Laralaunch" Height="780" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">
    
    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="BgBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#182234"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="PrimaryGreenHover" Color="#059669"/>
        <SolidColorBrush x:Key="AccentIndigo" Color="#6366F1"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        
        <!-- Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentIndigo}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: RECENT PROJECTS -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Laralaunch" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Laravel Repository Automated Launcher" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Recent Projects Header -->
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <TextBlock Text="RECENT PROJECTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <!-- List of Recent Projects -->
                <ListBox x:Name="LstRecentProjects" Grid.Row="2" 
                         Background="Transparent" BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="LstRecentProjects_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="0" Padding="10" Margin="0,4,0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                        <TextBlock Text="▶ " Foreground="{StaticResource PrimaryGreen}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FolderPath}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
                                    <Border HorizontalAlignment="Left" Background="#0F172A" CornerRadius="0" Padding="6,2">
                                        <TextBlock Text="{Binding ModeBadge}" Foreground="{StaticResource PrimaryGreen}" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom Quick Info -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Button Content="⚙️ Settings &amp; Laragon Path" Click="BtnSettings_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT MAIN WORKSPACE -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Selected Project Card -->
                <RowDefinition Height="Auto"/> <!-- Options & Toggles Card -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                <RowDefinition Height="*"/>    <!-- Log Output Terminal -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. SELECTED PROJECT CARD -->
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="0" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="SELECTED PROJECT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtSelectedPath" Text="No project selected..." FontSize="14" FontFamily="Consolas, Courier New" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel x:Name="PnlValidationStatus" Orientation="Horizontal">
                            <Border x:Name="BdrValidationBadge" Background="#334155" CornerRadius="0" Padding="8,3">
                                <TextBlock x:Name="TxtValidationStatus" Text="Please select a Laravel directory" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="📁 Select Laravel Project" Click="BtnBrowseProject_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- 2. OPTIONS & SERVICES CARD -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="0" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SERVICES &amp; LAUNCH OPTIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Toggles -->
                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="ChkStartLaragon" Content="☑ Start Laragon" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkStartApache" Content="☑ Apache Service" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkStartMySQL" Content="☑ MySQL Service" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkAutoMigrate" Content="☑ Auto Run Migrations (php artisan migrate)" IsChecked="False" Foreground="White" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkForceSetup" Content="⚡ Force Setup (Reinstall Composer &amp; NPM)" IsChecked="False" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Execution Mode: " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbExecutionMode" Width="200" SelectedIndex="0" Margin="8,0,0,0">
                                    <ComboBoxItem Content="Auto (Detect Laragon .test)"/>
                                    <ComboBoxItem Content="Mode A: Localhost (:8000)"/>
                                    <ComboBoxItem Content="Mode B: Laragon (.test)"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. ACTION BUTTONS -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="BtnRunProject" Content="🚀 RUN PROJECT" Click="BtnRunProject_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                <Button x:Name="BtnStopServer" Content="⏹ STOP SERVER" Click="BtnStopServer_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" Margin="0,0,12,0"/>
                <Button x:Name="BtnForceSetup" Content="⚡ Run Setup Only" Click="BtnForceSetup_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>

            <!-- 4. LIVE CONSOLE / LOG TERMINAL -->
            <Border Grid.Row="3" Background="#020617" CornerRadius="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="💻 EXECUTION LOGS &amp; SYSTEM OUTPUT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Clear" Click="BtnClearLog_Click" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
                            <Button Content="Copy" Click="BtnCopyLog_Click" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="TxtLogs" Grid.Row="1" 
                             Background="Transparent" Foreground="#38BDF8" BorderThickness="0"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- 5. STATUS BAR -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{StaticResource PrimaryGreen}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
